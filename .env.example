# ===== Ciao API (Railway service: ciao-api) =====
DATABASE_URL=postgres://...          # Railway Postgres plugin injects this
JWT_SECRET=change-me-64-random-chars
ACTION_TOKEN_SECRET=change-me-different-64-random-chars
WEB_BASE_URL=https://ciao.ly
API_BASE_URL=https://api.ciao.ly
CORS_ORIGINS=https://ciao.ly,https://www.ciao.ly
NODE_ENV=production

# Payments (§10.2) — start with mock, switch to plutu when merchant account lands
PAYMENT_PROVIDER=mock                # mock | plutu
PLUTU_API_KEY=
PLUTU_ACCESS_TOKEN=
PLUTU_SECRET_KEY=
PLUTU_BASE_URL=https://api.plutu.ly/v1

# Messaging (§13.5) — console logs until WhatsApp BSP approved
MESSAGING_PROVIDER=console           # console | live
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_SENDER_ID=CIAO

# Worker: in-process by default; set external + deploy apps/api worker service to split
# WORKER_MODE=external

# ===== Ciao web (Railway service: ciao-web) =====
# Set as build arg / service variable:
NEXT_PUBLIC_API_URL=https://api.ciao.ly

# Maps — which one renders is the console's call (maps.provider); these decide
# which ones are ALLOWED to. Baked in at build time, so a token added here needs
# a rebuild, not a restart. No token => the map falls back silently, never breaks.
# Mapbox is the default provider: public pk.* token, restrict it by URL.
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
